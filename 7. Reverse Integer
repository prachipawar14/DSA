class Solution:
    def reverse(self, x: int) -> int:
        rev = 0
        n = x
        
        if x < 0:
            x = abs(x)
        
        while x > 0:
            ld = x % 10
            rev = (rev * 10) + ld
            x = x // 10
        
        if n < 0:
            rev = -rev
            
        if rev < -2**31 or rev > 2**31 - 1:
            return 0
            
        return rev
